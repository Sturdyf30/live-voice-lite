# ---------- App ----------
HOST=127.0.0.1
PORT=8766
MAX_UPLOAD_MB=12
MAX_AUDIO_SECONDS=45

# ---------- Brain: Hermes Agent (default) ----------
# Enable the Hermes API server, then use these values.
LLM_BACKEND=chat_completions
LLM_BASE_URL=http://127.0.0.1:8642/v1
LLM_API_KEY=change-me-local-dev
LLM_MODEL=hermes-agent
LLM_MAX_OUTPUT_TOKENS=700
HISTORY_TURNS=12

# Direct OpenAI Responses API alternative:
# LLM_BACKEND=openai_responses
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=YOUR_OPENAI_MODEL

# Ollama/vLLM/llama.cpp alternative:
# LLM_BACKEND=chat_completions
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=local
# LLM_MODEL=qwen3:8b

# ---------- Speech to text: local and free ----------
STT_BACKEND=local
STT_MODEL=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en

# API transcription alternative:
# STT_BACKEND=openai_compatible
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=sk-...
# STT_MODEL=YOUR_TRANSCRIPTION_MODEL

# ---------- Text to speech: local Kokoro ----------
TTS_BACKEND=openai_compatible
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_API_KEY=not-needed
TTS_MODEL=kokoro
TTS_VOICE=af_heart
TTS_SPEED=1.05
TTS_MAX_CHARS=1800

# To run without spoken output:
# TTS_BACKEND=disabled
